{
  "name": "prodigy-event-control",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "preserve": "npm run assets:check",
    "serve": "firebase emulators:start --only hosting,auth,firestore,functions",
    "preserve:hosting": "npm run assets:check",
    "serve:hosting": "firebase emulators:start --only hosting",
    "assets:version": "node scripts/version-first-party-assets.mjs --write",
    "assets:check": "node scripts/version-first-party-assets.mjs --check",
    "test:assets": "node tests/asset-versioning.test.mjs",
    "test:hosting:assets": "firebase emulators:exec --only hosting --project demo-prodigy-assets \"node tests/hosting-asset-versioning.test.mjs\"",
    "test:security:rules": "node tests/firestore-authorization.test.mjs",
    "test:security:competition": "node tests/competition-security.test.cjs",
    "test:competition:decisions": "node tests/post-battle-decision.test.cjs",
    "test:competition:lifecycle": "node tests/bracket-lifecycle.test.cjs",
    "test:bracket:presentation": "node tests/bracket-presentation.test.mjs",
    "test:lineup:preview": "node tests/lineup-preview.test.mjs",
    "test:event-selection": "node tests/event-selection-sync.test.mjs",
    "test:historical-bracket": "node tests/historical-bracket-recovery.test.mjs",
    "test:security:callable": "node tests/callable-authorization.test.mjs",
    "test:security:battles": "node tests/battle-authorization.test.mjs",
    "test:qualifying:finalization": "node tests/qualifying-run-finalization.test.mjs",
    "test:sample-loader": "node tests/sample-driver-loader.test.mjs",
    "test:sync:emulator": "firebase emulators:exec --only auth,firestore,functions --project prodigy-rc-competitions \"node tests/judge-sync.test.mjs && node tests/qualifying-sync.test.mjs\"",
    "test:legacy": "node tests/legacy-features.test.mjs",
    "test:legacy:emulator": "node tests/legacy-functions-emulator.test.mjs",
    "test:security:emulator": "node tests/firestore-authorization.test.mjs && node tests/callable-authorization.test.mjs && node tests/battle-authorization.test.mjs",
    "simulate:twin": "node scripts/twin-triple-simulator.mjs"
  }
}
